    {"id":"s1","src":[0.00,3.09],"text":"Meta punya AI baru yang katanya bisa bantu mengurus usaha.","pad":[0,0.08]},
    {"id":"s2","src":[3.62,4.89],"text":"Bisa dipakai di Indonesia?","pad":[0.05,0.08]},
    {"id":"s3","src":[6.46,6.96],"text":"Belum bisa.","pad":[0.05,0.10]},
    {"id":"s4","src":[7.37,11.60],"text":"Namanya Muse. Bedanya dengan chatbot, Muse tidak cuma menjawab, tapi mengerjakan.","pad":[0.05,0.08]},
    {"id":"s5","src":[19.39,22.76],"text":"Akhir September, Meta menambahkan versi usaha kecil.","pad":[0.05,0.08]},
    {"id":"s6","src":[26.77,28.40],"text":"Disambungkan ke akun bisnis Facebook,","pad":[0.05,0.06]},
    {"id":"s7","src":[28.74,30.37],"text":"Instagram, sampai Canva.","pad":[0.05,0.10]},
    {"id":"s8","src":[33.84,37.74],"text":"Tapi sampai hari ini, Muse baru bisa dipakai di Amerika Serikat dan Kanada.","pad":[0.05,0.10]},
    {"id":"s9","src":[48.64,50.32],"text":"Saya coba lewat web, pakai VPN,","pad":[0.05,0.06]},
    {"id":"s10","src":[50.67,51.45],"text":"tetap belum bisa.","pad":[0.05,0]},
    {"id":"s11","src":[51.45,55.24],"text":"Satu yang sering keliru: Meta AI di WhatsApp itu bukan Muse.","pad":[0,0.10]},
    {"id":"s12","src":[55.84,57.44],"text":"Itu chatbot. Bisa menjawab,","pad":[0.05,0.06]},
    {"id":"s13","src":[57.80,59.40],"text":"belum bisa mengerjakan tugas untuk Anda.","pad":[0.05,0.10]},
    {"id":"s14","src":[67.29,69.81],"text":"Meta bilang Muse bisa mengurangi pekerjaan owner.","pad":[0.05,0.10]},
    {"id":"s15","src":[73.36,74.66],"text":"Contoh yang mereka pamerkan:","pad":[0.05,0.06]},
    {"id":"s16","src":[86.00,87.36],"text":"Cari pengeluaran yang janggal,","pad":[0.05,0.06]},
    {"id":"s17","src":[87.65,89.30],"text":"saring email yang perlu dibalas,","pad":[0.05,0.06]},
    {"id":"s18","src":[89.54,91.75],"text":"dan analisis konten lalu buat draf kampanye.","pad":[0.05,0.10]},
    {"id":"s19","src":[92.31,94.93],"text":"Tapi dari Indonesia, semua itu belum bisa saya uji.","pad":[0.05,0.10]},
    {"id":"s20a","src":[95.00,95.97],"text":"Katanya bisa.","pad":[0.04,0.03]},
    {"id":"s20gap","src":[96.44,96.72],"text":"","pad":[0,0],"caption":false},
    {"id":"s20b","src":[97.07,98.91],"text":"Nyatanya belum bisa dicoba.","pad":[0.04,0.12]},
    {"id":"s21","src":[102.60,105.31],"text":"Tugas usaha apa yang ingin Anda serahkan kepada AI?","pad":[0.04,0.08]},
    {"id":"s22","src":[105.64,107.39],"text":"Komentar, Muse bisa saya uji,","pad":[0.05,0.06]},
    {"id":"s23","src":[107.75,109.70],"text":"tugas Anda yang saya coba duluan.","pad":[0.05,0.15]}
